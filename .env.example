DB_PASSWORD=change-me
JWT_ISSUER=helvoca-api
# Base64-encoded secret. Replace for any non-local environment.
JWT_SECRET=Y2FsbGFpLWRldi1vbmx5LXNlY3JldC1rZXktMzItYnl0ZXMhISE=
SEED_ADMIN_EMAIL=admin@helvoca.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# Voice routing. Ordered list: first healthy provider wins.
HELVOCA_TELEPHONY_PROVIDER=twilio
HELVOCA_VOICE_AI_PROVIDER=openai
HELVOCA_VOICE_PROVIDER_ORDER=gemini,openai-live

# Twilio. Never commit real credentials.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PUBLIC_BASE_URL=https://your-public-domain.example
TWILIO_MEDIA_STREAM_PATH=/ws/v1/twilio/media

# Twilio WhatsApp inbound. Keep disabled until the real Twilio webhook is configured and ready to test.
TWILIO_WHATSAPP_ENABLED=false
TWILIO_WHATSAPP_WEBHOOK_VALIDATION_ENABLED=true
TWILIO_WHATSAPP_SESSION_HOURS=24

# Meta WhatsApp Cloud API. Safe defaults keep the integration disabled.
# Graph API v26.0 is the current Meta Graph API version as of 2026-09.
META_WHATSAPP_ENABLED=false
META_WHATSAPP_WEBHOOK_VALIDATION_ENABLED=true
META_WHATSAPP_GRAPH_API_VERSION=v26.0
META_WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_APP_SECRET=

# Durable inbound rollout. Keep both async switches disabled until staged certification.
HELVOCA_META_WHATSAPP_ASYNC_TEXT_ENABLED=false
HELVOCA_META_WHATSAPP_ASYNC_AUDIO_ENABLED=false
HELVOCA_META_WHATSAPP_TEXT_MAX_ATTEMPTS=5
HELVOCA_META_WHATSAPP_AUDIO_MAX_ATTEMPTS=6

# WhatsApp speech-to-text routing. Deepgram remains disabled until its secret is configured securely.
HELVOCA_AUDIO_TRANSCRIPTION_PROVIDER_ORDER=deepgram,gemini,openai
HELVOCA_AUDIO_TRANSCRIPTION_RETRY_MIN_MS=250
HELVOCA_AUDIO_TRANSCRIPTION_RETRY_MAX_MS=500
HELVOCA_AUDIO_TRANSCRIPTION_CIRCUIT_FAILURE_THRESHOLD=3
HELVOCA_AUDIO_TRANSCRIPTION_CIRCUIT_COOLDOWN_SECONDS=60
DEEPGRAM_TRANSCRIPTION_ENABLED=false
DEEPGRAM_API_KEY=
DEEPGRAM_TRANSCRIPTION_ENDPOINT=https://api.deepgram.com/v1/listen
DEEPGRAM_TRANSCRIPTION_MODEL=nova-3
DEEPGRAM_TRANSCRIPTION_LANGUAGE=multi
DEEPGRAM_TRANSCRIPTION_TIMEOUT_SECONDS=15

META_WHATSAPP_EMBEDDED_SIGNUP_ENABLED=false
META_WHATSAPP_EMBEDDED_SIGNUP_APP_ID=
META_WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
# Meta Business Manager ID for the RecepVoz provider/partner account.
META_WHATSAPP_EMBEDDED_SIGNUP_BUSINESS_ID=
# System User ID used when assigning RecepVoz to a client WABA.
META_WHATSAPP_EMBEDDED_SIGNUP_SYSTEM_USER_ID=
# Server-side token used for Embedded Signup Graph API reads and token validation.
META_WHATSAPP_EMBEDDED_SIGNUP_SYSTEM_USER_ACCESS_TOKEN=
# Admin System User token required only for assigning the System User to a WABA.
META_WHATSAPP_EMBEDDED_SIGNUP_ADMIN_SYSTEM_USER_ACCESS_TOKEN=

# Outbound WhatsApp. Safe defaults intentionally prevent real customer-facing delivery.
HELVOCA_OUTBOUND_DELIVERY_ENABLED=false
HELVOCA_OUTBOUND_PROVIDER=NONE

# Durable jobs dispatch outbound messages. Enable only for an authorized real-delivery test.
APP_JOBS_ENABLED=false

# Gemini Live native audio. Leave disabled until a valid key is configured.
GEMINI_LIVE_ENABLED=false
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Kore
GEMINI_LIVE_WEBSOCKET_URL=wss://generativelanguage.googleapis.com/ws/google.ai.generativelanguage.v1beta.GenerativeService.BidiGenerateContent

# OpenAI. Never commit the real API key.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_TRANSCRIPTION_MODEL=gpt-live-transcribe
OPENAI_WHATSAPP_TRANSCRIPTION_FALLBACK_MODEL=whisper-1
OPENAI_SUMMARY_MODEL=gpt-5.6-luna
OPENAI_SIMULATOR_MODEL=gpt-5.6-luna
OPENAI_REALTIME_URL=wss://api.openai.com/v1/realtime
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses

# OpenAI GPT-Live SIP provider. It is optional when another Live provider is healthy.
OPENAI_LIVE_ENABLED=false
OPENAI_PROJECT_ID=
OPENAI_WEBHOOK_SECRET=
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_LIVE_BACKEND_MODEL=gpt-5.6-luna
OPENAI_LIVE_VOICE=marin
OPENAI_LIVE_API_BASE_URL=https://api.openai.com/v1
OPENAI_LIVE_SIDEBAND_BASE_URL=wss://api.openai.com/v1


# One-shot activation for the visual catalog handoff. Keep disabled normally.
HELVOCA_PRODUCT_SHOWCASE_ACTIVATE_ON_STARTUP=false
HELVOCA_PRODUCT_SHOWCASE_BUSINESS_ID=

# One-shot activation for quoting a product already selected from a showcase.
HELVOCA_SELECTED_PRODUCT_QUOTE_ACTIVATE_ON_STARTUP=false
HELVOCA_SELECTED_PRODUCT_QUOTE_BUSINESS_ID=

# One-shot activation for the catalog -> order -> payment commercial checkout journey.
HELVOCA_COMMERCIAL_CHECKOUT_ACTIVATE_ON_STARTUP=false
HELVOCA_COMMERCIAL_CHECKOUT_BUSINESS_ID=

# One-shot full commercial Sandbox E2E: showcase -> selection -> quote -> order -> payment.
# Uses isolated certification customer/product and a deterministic run id.
HELVOCA_COMMERCIAL_SANDBOX_CERTIFY_ON_STARTUP=false
HELVOCA_COMMERCIAL_SANDBOX_CERTIFY_BUSINESS_ID=
HELVOCA_COMMERCIAL_SANDBOX_CERTIFY_RUN_ID=
HELVOCA_COMMERCIAL_SANDBOX_CERTIFY_AMOUNT_CLP=1000

# One-shot tenant bootstrap for Mercado Pago merchant payments (SANDBOX only).
# Secrets are resolved from HELVOCA_PAYMENT_<CREDENTIAL_REF>_* and must never be committed.
HELVOCA_MERCHANT_PAYMENT_BOOTSTRAP_ON_STARTUP=false
HELVOCA_MERCHANT_PAYMENT_BUSINESS_ID=
HELVOCA_MERCHANT_PAYMENT_CREDENTIAL_REF=RECEPVOZ_MP_SANDBOX

# One-shot real provider certification. Creates one isolated SANDBOX checkout only.
HELVOCA_MERCHANT_PAYMENT_CERTIFY_ON_STARTUP=false
HELVOCA_MERCHANT_PAYMENT_CERTIFY_AMOUNT_CLP=1000

# One-shot read-only verification of an existing Mercado Pago Sandbox order.
HELVOCA_MERCHANT_PAYMENT_STATUS_CHECK_ON_STARTUP=false
HELVOCA_MERCHANT_PAYMENT_STATUS_EXTERNAL_ID=

# Safety net when a provider webhook is delayed or lost.
HELVOCA_MERCHANT_PAYMENT_RECONCILE_ENABLED=false
HELVOCA_MERCHANT_PAYMENT_RECONCILE_INITIAL_DELAY_MS=15000
HELVOCA_MERCHANT_PAYMENT_RECONCILE_DELAY_MS=60000
HELVOCA_PAYMENT_RECEPVOZ_MP_SANDBOX_ACCESS_TOKEN=
HELVOCA_PAYMENT_RECEPVOZ_MP_SANDBOX_WEBHOOK_SECRET=
HELVOCA_PAYMENT_RECEPVOZ_MP_SANDBOX_SANDBOX_CONFIRMED=false
