DB_PASSWORD=change-me
JWT_ISSUER=helvoca-api
# Base64-encoded secret. Replace for any non-local environment.
JWT_SECRET=Y2FsbGFpLWRldi1vbmx5LXNlY3JldC1rZXktMzItYnl0ZXMhISE=
SEED_ADMIN_EMAIL=admin@helvoca.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# Voice routing. Ordered list: first healthy provider wins.
HELVOCA_TELEPHONY_PROVIDER=twilio
HELVOCA_VOICE_AI_PROVIDER=openai
HELVOCA_VOICE_PROVIDER_ORDER=gemini,openai-live

# Twilio. Never commit the real Auth Token.
TWILIO_AUTH_TOKEN=
TWILIO_PUBLIC_BASE_URL=https://your-public-domain.example
TWILIO_MEDIA_STREAM_PATH=/ws/v1/twilio/media

# Gemini Live native audio. Leave disabled until a valid key is configured.
GEMINI_LIVE_ENABLED=false
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Kore
GEMINI_LIVE_WEBSOCKET_URL=wss://generativelanguage.googleapis.com/ws/google.ai.generativelanguage.v1beta.GenerativeService.BidiGenerateContent

# OpenAI. Never commit the real API key.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_TRANSCRIPTION_MODEL=gpt-live-transcribe
OPENAI_SUMMARY_MODEL=gpt-5.6-luna
OPENAI_SIMULATOR_MODEL=gpt-5.6-luna
OPENAI_REALTIME_URL=wss://api.openai.com/v1/realtime
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses

# OpenAI GPT-Live SIP provider. It is optional when another Live provider is healthy.
OPENAI_LIVE_ENABLED=false
OPENAI_PROJECT_ID=
OPENAI_WEBHOOK_SECRET=
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_LIVE_BACKEND_MODEL=gpt-5.6-luna
OPENAI_LIVE_VOICE=marin
OPENAI_LIVE_API_BASE_URL=https://api.openai.com/v1
OPENAI_LIVE_SIDEBAND_BASE_URL=wss://api.openai.com/v1
