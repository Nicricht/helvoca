# Standalone read-only demo preview; deliberately does NOT run Spring, PostgreSQL or providers.
FROM node:22-bookworm-slim AS frontend-build
WORKDIR /build
COPY package.json ./
COPY frontend/package.json ./frontend/package.json
RUN npm install --no-audit --no-fund
COPY frontend ./frontend
COPY src/main/resources/static ./src/main/resources/static
RUN npm run frontend:build

FROM node:22-alpine
WORKDIR /preview
ENV NODE_ENV=production
ENV PORT=8080
COPY --from=frontend-build /build/src/main/resources/static/app ./public/app
COPY --from=frontend-build /build/src/main/resources/static/frontend-foundation.css ./public/frontend-foundation.css
COPY tools/demo-preview/server.mjs ./server.mjs
USER node
EXPOSE 8080
CMD ["node", "server.mjs"]
